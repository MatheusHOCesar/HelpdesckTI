Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/focal64"

  # VM 1: Frontend (Gateway e Proxy Reverso)
  config.vm.define "frontend" do |frontend|
    frontend.vm.hostname = "frontend"
    frontend.vm.network "private_network", ip: "10.20.30.1"
    frontend.vm.network "forwarded_port", guest: 80, host: 8080
    # http://localhost:8080/
    # http://localhost:8080/api/chamados 
    
    frontend.vm.provision "shell", inline: <<-SHELL
      echo "1" > /proc/sys/net/ipv4/ip_forward
      iptables -t nat -A POSTROUTING -s 10.20.30.0/24 -o eth0 -j MASQUERADE
      apt-get update && apt-get install -y nginx
      cp /vagrant/proxy/default /etc/nginx/sites-available/default
      cp /vagrant/frontend/index.html /var/www/html/index.html
      systemctl restart nginx
    SHELL
  end

  # VM 3: Database (MySQL Isolado)
  config.vm.define "db" do |db|
    db.vm.hostname = "db"
    db.vm.network "private_network", ip: "10.20.30.3"
    
    db.vm.provision "shell", inline: <<-SHELL
      apt-get update && apt-get install -y mysql-server
      sed -i 's/bind-address.*/bind-address = 0.0.0.0/' /etc/mysql/mysql.conf.d/mysqld.cnf
      systemctl restart mysql
      mysql < /vagrant/database/db_setup.sql
      
      ip route del default
      ip route add default via 10.20.30.1
      rm -f /etc/resolv.conf && echo "nameserver 8.8.8.8" > /etc/resolv.conf
    SHELL
  end

  # VM 2: Backend (API Python)
  config.vm.define "backend" do |backend|
    backend.vm.hostname = "backend"
    backend.vm.network "private_network", ip: "10.20.30.2"
    
    backend.vm.provision "shell", inline: <<-SHELL
      apt-get update && apt-get install -y python3-pip python3-venv
      cd /vagrant/backend
      pip3 install -r requirements.txt
      
      echo "[Unit]" > /etc/systemd/system/helpdesk.service
      echo "Description=API Helpdesk Flask" >> /etc/systemd/system/helpdesk.service
      echo "After=network.target" >> /etc/systemd/system/helpdesk.service
      echo "RequiresMountsFor=/vagrant" >> /etc/systemd/system/helpdesk.service
      echo "[Service]" >> /etc/systemd/system/helpdesk.service
      echo "User=root" >> /etc/systemd/system/helpdesk.service
      echo "WorkingDirectory=/vagrant/backend" >> /etc/systemd/system/helpdesk.service
      echo "ExecStart=/usr/bin/python3 app.py" >> /etc/systemd/system/helpdesk.service
      echo "Restart=always" >> /etc/systemd/system/helpdesk.service
      echo "RestartSec=5" >> /etc/systemd/system/helpdesk.service
      echo "[Install]" >> /etc/systemd/system/helpdesk.service
      echo "WantedBy=multi-user.target" >> /etc/systemd/system/helpdesk.service

      systemctl daemon-reload
      systemctl enable helpdesk
      systemctl start helpdesk

      ip route del default
      ip route add default via 10.20.30.1
      rm -f /etc/resolv.conf && echo "nameserver 8.8.8.8" > /etc/resolv.conf
    SHELL
  end
end